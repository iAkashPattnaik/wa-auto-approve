# --- WhatsApp ---
# Get this via `npm run resolve-group` after first QR login (or paste invite-link group id).
# Long-form group id, e.g. 1203630XXXXXXX@g.us
GROUP_JID=
# Optional fallback if GROUP_JID empty: exact group subject/name to auto-resolve
GROUP_NAME=

# --- Google Sheets ---
# From sheet URL: docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
SPREADSHEET_ID=
SHEET_TAB=Technical
PHONE_COL=Phone Number
STATUS_COL=in_grp
# Path to service-account JSON downloaded from Google Cloud Console
GOOGLE_CREDENTIALS_PATH=./credentials.json

# --- Behaviour ---
# 91 = India. Prepended when sheet/request number has only 10 digits.
DEFAULT_COUNTRY_CODE=91
# Poll interval in ms (90000 = 90s). Keep >= 60000 to respect rate limits.
POLL_INTERVAL_MS=90000
# Delay between approvals in ms (2500 = 2.5s). Do not set below 2000.
APPROVE_DELAY_MS=2500
# true = log only, no approve, no sheet write. Set false to go live.
DRY_RUN=true
# Minutes to cache the LID->phone map (WhatsApp LIDs are stable). Default 30.
LID_CACHE_TTL_MIN=30

# --- Bulk sender (npm run send-msg) ---
# Column tracking outreach; auto-created if missing. Only delivered msgs get marked.
SENT_MSG_COL=sent_msg
SENT_MSG_VALUE=TRUE
# Message template file (edit message.txt) or inline fallback:
MESSAGE_FILE=./message.txt
# MSG_TEXT=Hello from GDGoC!
# Delay between DMs in ms. Keep >= 3000 to avoid bans.
MSG_DELAY_MS=3500
